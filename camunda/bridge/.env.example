# Copy to camunda/bridge/.env (git-ignored) and adjust if needed.
# Only needed if you want the bridge/outcome workers pointed at a Zeebe gateway other than the
# local Docker Compose stack's default (localhost:26500, ZEEBE_AUTHENTICATION_MODE=none per
# camunda/.env). DATABASE_URL is deliberately NOT duplicated here - it's read from the
# environment or falls back to backend/.env, same convention as db/apply_migration.py.
ZEEBE_ADDRESS=localhost:26500
