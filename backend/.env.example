# Copy to backend/.env (git-ignored) and fill in. Never commit the real values.
# Neon connection string. Prefer the pooled (PgBouncer) host - it has "-pooler" in the hostname, e.g.
# postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require
# Faster per-request connection setup than the direct host; safe here since no code uses session-level
# features (SET, LISTEN/NOTIFY, prepared statements, temp tables) that transaction pooling can't support.
DATABASE_URL=
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DB_POOL_MAX=20
# Refresh Now (specs/refresh-now.md) - optional; without these the button says it isn't set up.
# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net, and a personal access token
# (Databricks: user settings -> Developer -> Access tokens) allowed to run the bank-data-pipeline job.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Optional: the job's id; if blank it's found by its name, bank-data-pipeline.
DATABRICKS_JOB_ID=
