# Copy to backend/.env (git-ignored) and fill in. Never commit the real values.
# Neon connection string, direct (non-pooled) host: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DB_POOL_MAX=5
