# Local Claude Code tooling config — machine/session-specific, not a project deliverable.
# Skills under .claude/skills/ ARE tracked (e.g. .claude/skills/git-commit-push/), so this only
# ignores the local settings file, not the whole .claude/ directory.
.claude/settings.json
.claude/settings.local.json

# Databricks AI-tools local cache/state
.databricks/

# Editor-local settings
.vscode/

# Reference material (legacy treasury CSVs, external PDFs) — not project deliverables
resources/

# Python / backend local files
backend/.env
backend/.venv/
__pycache__/
.pytest_cache/
