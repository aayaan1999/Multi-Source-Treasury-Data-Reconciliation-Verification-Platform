# Local Claude Code tooling config — machine/session-specific, not a project deliverable.
# Skills under .claude/skills/ ARE tracked (e.g. .claude/skills/git-commit-push/), so this only
# ignores the local settings file, not the whole .claude/ directory.
.claude/settings.json
.claude/settings.local.json

# Databricks AI-tools local cache/state
.databricks/

# Editor-local settings
.vscode/

# Reference material (legacy treasury CSVs, external PDFs) — not project deliverables
resources/

# Environment-specific files: secrets, per-machine settings and local build output.
# Only the *.example templates are committed; copy one to .env and fill it in locally.
.env
.env.*
!.env.example
*.local

# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
*.log

# Hosting-tool local state (created by the Netlify / Render / Vercel CLIs, not needed in Git)
.netlify/
.vercel/
